# Copy to .env for local development. Never commit the real .env file.
OPENWEATHER_API_KEY=

# Local only: simulated signed-in user. Refused when running on App Service.
AUTH_MODE=local
LOCAL_DEV_USER_NAME=Local Developer

# Local PostgreSQL started by docker-compose.yml
PG_AUTH=password
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=weather
PGUSER=weather_app
PGPASSWORD=
PGSSLMODE=disable

# Optional tuning
WEATHER_CACHE_SECONDS=600
ACTIVITY_RETENTION_DAYS=90
